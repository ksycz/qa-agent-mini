ANTHROPIC_API_KEY=
# Optional: the model to use (default claude-haiku-5-5) and a Chrome to use instead of Playwright's own.
QA_AGENT_MODEL=claude-haiku-5-5
# QA_AGENT_BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# LangGraph Studio (`npm run studio`, step 20b): keep run data on this computer, and use the fake model unless the second line is set.
# LANGSMITH_TRACING=false
# QA_AGENT_STUDIO_MODEL=claude-haiku-5-5
